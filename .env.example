# Carrera Race Control configuration. Copy to `.env` (repo root or backend/) and fill in.
# Never commit `.env`. Empty values count as "not set".

# --- ElevenLabs text-to-speech (optional: without a key the commentary is text only)
ELEVENLABS_API_KEY=
# Voice used by the commentator (can be overridden per user in Settings).
ELEVENLABS_VOICE_ID=
# Optional model override; default is eleven_flash_v2_5 (lowest latency, multilingual).
ELEVENLABS_MODEL_ID=

# --- Anthropic LLM for varied low-priority commentary (optional, enable it in Settings)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Track
# simulator | ble | serial. If set, it decides the startup mode (only the simulator is
# connected automatically; BLE/serial wait for "Connect" in the UI). If unset, the mode
# last used in the UI is kept.
# TRACK_MODE=simulator
# BLE address (AA:BB:CC:DD:EE:FF, or a UUID on macOS) or serial port (COM3, /dev/ttyUSB0).
TRACK_ADDRESS=

# --- Commentary language for a fresh settings database: it | en (then change it in Settings)
COMMENTARY_LANG=it

# --- Storage: SQLite database and TTS audio cache (default: backend/data)
# DATA_DIR=backend/data

# --- Simulator
# Number of simulated cars (1-6).
# SIM_CARS=4
# Simulated time speed-up (1.0 = real time).
# SIM_TIME_SCALE=1.0
# Replay a recorded JSONL session (python -m app.track.console --record FILE) instead of
# the simulator when connecting in simulator mode.
# REPLAY_FILE=

# --- Dev: comma-separated origins allowed by CORS (the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated Host names the server answers to (DNS rebinding guard). Add your
# machine name only if you really need it; the API has no authentication.
# ALLOWED_HOSTS=127.0.0.1,localhost
